# ==================================================
# Employee Policy RAG Environment Configuration
# ==================================================

# Vector Store Engine
# Options: pinecone (recommended) | chroma (local)
VECTOR_STORE_TYPE=pinecone

# Pinecone Cloud Vector Database
# Get your free API key at: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=employee-policy-rag

# Groq High-Speed LPU Cloud LLM
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# Local Fallback LLM (used if GROQ_API_KEY is not set)
OLLAMA_MODEL=qwen3:8b
